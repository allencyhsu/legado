# Legado Server Nginx 反向代理配置範例
#
# 安裝步驟:
#   1. 安裝 Nginx: sudo apt install -y nginx
#   2. 複製此檔案: sudo cp nginx.conf.example /etc/nginx/sites-available/legado-server
#   3. 修改 server_name 為您的域名
#   4. 啟用配置: sudo ln -s /etc/nginx/sites-available/legado-server /etc/nginx/sites-enabled/
#   5. 測試配置: sudo nginx -t
#   6. 重新載入: sudo systemctl reload nginx
#
# HTTPS 設置 (使用 Let's Encrypt):
#   sudo apt install -y certbot python3-certbot-nginx
#   sudo certbot --nginx -d books.example.com
#

# HTTP 配置 (基本)
server {
    listen 80;
    listen [::]:80;

    # 修改為您的域名
    server_name books.example.com;

    # 日誌
    access_log /var/log/nginx/legado-server.access.log;
    error_log /var/log/nginx/legado-server.error.log;

    # 反向代理到 legado-server
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # 傳遞原始請求資訊
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 支援 (如需要)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # 超時設置 (TTS 語音合成可能需要較長時間)
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;

        # 緩衝設置
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }

    # 靜態資源快取
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # 快取設置
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
}

